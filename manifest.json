{
  "manifest_version": 3,
  "name": "Suivi Naturalisation",
  "version": "1.0.0",
  "description": "Extension permettant de suivre une demande de naturalisation.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
